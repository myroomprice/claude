// MyRoomPrice web app on Cloudflare: an assets-only Worker that serves docs/ (built by tools/build_page.py)
// at myroomprice.com. Deploy with: npx wrangler deploy
{
  "name": "myroomprice",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./docs" },
  "routes": [
    { "pattern": "myroomprice.com", "custom_domain": true },
    { "pattern": "www.myroomprice.com", "custom_domain": true }
  ],
  "workers_dev": false
}
